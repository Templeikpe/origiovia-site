# ============================================================
# Netlify : en-têtes HTTP de sécurité (fichier _headers)
# Doit être placé à la RACINE du site, au même niveau que index.html.
# Netlify l'applique automatiquement au déploiement.
# ============================================================

/*
  # Interdit d'afficher le site dans un cadre (iframe) d'un autre site : protège du clickjacking.
  X-Frame-Options: DENY
  # Empêche le navigateur de deviner le type d'un fichier.
  X-Content-Type-Options: nosniff
  # N'envoie que le domaine (pas l'adresse complète) aux sites externes.
  Referrer-Policy: strict-origin-when-cross-origin
  # Désactive les fonctions du navigateur dont le site n'a pas besoin.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # Force HTTPS pendant 1 an. Volontairement SANS includeSubDomains : à ajouter seulement
  # quand tous les sous-domaines (par exemple ceux du courrier) sont en HTTPS.
  Strict-Transport-Security: max-age=31536000
  # CSP en mode RAPPORT SEULEMENT : ne bloque rien, signale seulement dans la console du navigateur.
  # Elle autorise Google Fonts et Google Translate, utilisés par le site. Après quelques jours
  # sans erreur dans la console (F12), remplacer le nom de l'en-tête par Content-Security-Policy.
  # 'unsafe-inline' est nécessaire car les pages contiennent des scripts et styles en ligne.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://translate.google.com https://translate.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://translate.googleapis.com https://translate.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Images, CSS et JS : le navigateur les garde 1 jour en cache.
# (Si vous modifiez un fichier de assets/, les visiteurs le verront au plus tard le lendemain.)
/assets/*
  Cache-Control: public, max-age=86400
